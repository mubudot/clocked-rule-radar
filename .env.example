# Copy to .env (git-ignored). Environment variables override this file.

# --- Clocked ---------------------------------------------------------------
# live   = call the API (needs CLOCKED_API_KEY)
# replay = serve the recorded responses in fixtures/replay (no key; bundled sample only)
# record = like live, but saves new responses to fixtures/replay
# Default: live when CLOCKED_API_KEY is set, otherwise replay.
CLOCKED_MODE=
CLOCKED_API_KEY=

# --- Model that writes the brief ------------------------------------------
# offline   = template brief, no model
# openai    = any OpenAI-compatible /chat/completions server (OpenAI, OpenRouter, vLLM, Ollama, LM Studio...)
# anthropic = Anthropic Messages API (Claude) or a Messages-compatible gateway
RADAR_LLM_PROVIDER=offline
RADAR_LLM_MODEL=
# Defaults: https://api.openai.com/v1 (openai) / https://api.anthropic.com (anthropic)
RADAR_LLM_BASE_URL=
# Falls back to OPENAI_API_KEY or ANTHROPIC_API_KEY for the matching provider.
RADAR_LLM_API_KEY=
# anthropic only: x-api-key (default) or bearer (for gateways that take Authorization: Bearer)
RADAR_LLM_AUTH=
# Leave empty to use the server default (some models reject a non-default temperature).
RADAR_LLM_TEMPERATURE=
